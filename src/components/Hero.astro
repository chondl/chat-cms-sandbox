---
/**
 * Palette component. Quoted string attributes + Markdown children.
 *
 * LIVE-SITE CORRELATION FIXTURE: the eyebrow line is composed at render time
 * ("<eyebrow> · Sandbox Arts Boosters"), so the rendered string exists in no
 * content file. An eval phrased against the rendered page ("change the thing in
 * the hero banner") must use `fetch_live_page` and then correlate a fragment
 * back to the `eyebrow` attribute in the content file.
 */
interface Props {
  eyebrow: string;
  title: string;
}
const { eyebrow, title } = Astro.props;
---

<section class="hero">
  <p class="hero-eyebrow">{eyebrow} · Sandbox Arts Boosters</p>
  <h1>{title}</h1>
  <div class="hero-body">
    <slot />
  </div>
</section>
