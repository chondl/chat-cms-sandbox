---
interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/programs/', label: 'Programs' },
  { href: '/season/', label: 'Season' },
  { href: '/about/', label: 'About' },
  { href: '/donate/', label: 'Donate' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Sandbox Arts Boosters</title>
    {description && <meta name="description" content={description} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <header>
      <a href="/" class="wordmark">Sandbox Arts Boosters</a>
      <nav>
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>
        Sandbox Arts Boosters is a parent volunteer group. The Boosters support;
        the school runs the programs.
      </p>
    </footer>
  </body>
</html>
